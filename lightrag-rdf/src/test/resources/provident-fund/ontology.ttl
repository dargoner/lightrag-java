@prefix pf: <https://example.com/provident-fund#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix lg: <https://example.com/lightrag#> .

pf: a owl:Ontology ;
    owl:versionInfo "1.0" ;
    lg:definitionHash "provident-fund-fixture-v1" .

pf:Contributor a owl:Class ;
    rdfs:label "缴存职工" ;
    rdfs:comment "在缴存单位参加住房公积金制度的职工" .
pf:Employer a owl:Class ;
    rdfs:label "缴存单位" ;
    rdfs:comment "为职工缴存住房公积金的单位" .
pf:FundAccount a owl:Class ;
    rdfs:label "公积金账户" ;
    rdfs:comment "职工个人的住房公积金账户" .
pf:Loan a owl:Class ;
    rdfs:label "公积金贷款" ;
    rdfs:comment "住房公积金个人住房贷款" .
pf:Withdrawal a owl:Class ;
    rdfs:label "提取记录" ;
    rdfs:comment "住房公积金提取业务记录" .

pf:contributorName a owl:DatatypeProperty ;
    rdfs:label "姓名" ;
    lg:owner pf:Contributor ;
    rdfs:range xsd:string .
pf:contributorId a owl:DatatypeProperty ;
    rdfs:label "身份证号" ;
    lg:owner pf:Contributor ;
    rdfs:range xsd:string .
pf:contributionBase a owl:DatatypeProperty ;
    rdfs:label "缴存基数" ;
    lg:owner pf:Contributor ;
    rdfs:range xsd:double .
pf:monthlyContribution a owl:DatatypeProperty ;
    rdfs:label "月缴存额" ;
    lg:owner pf:Contributor ;
    rdfs:range xsd:double .
pf:phoneNumbers a owl:DatatypeProperty ;
    rdfs:label "联系电话" ;
    lg:owner pf:Contributor ;
    lg:valueType "LIST" .

pf:contributionRatio a owl:DatatypeProperty ;
    rdfs:label "缴存比例" ;
    lg:owner pf:Employer ;
    rdfs:range xsd:double .

pf:accountBalance a owl:DatatypeProperty ;
    rdfs:label "账户余额" ;
    lg:owner pf:FundAccount ;
    rdfs:range xsd:double .
pf:accountOpenedOn a owl:DatatypeProperty ;
    rdfs:label "开户日期" ;
    lg:owner pf:FundAccount ;
    rdfs:range xsd:date .

pf:loanAmount a owl:DatatypeProperty ;
    rdfs:label "贷款金额" ;
    lg:owner pf:Loan ;
    rdfs:range xsd:double .
pf:loanTermYears a owl:DatatypeProperty ;
    rdfs:label "贷款期限" ;
    lg:owner pf:Loan ;
    rdfs:range xsd:integer .
pf:loanRate a owl:DatatypeProperty ;
    rdfs:label "贷款利率" ;
    lg:owner pf:Loan ;
    rdfs:range xsd:double .
pf:loanAppliedOn a owl:DatatypeProperty ;
    rdfs:label "申请日期" ;
    lg:owner pf:Loan ;
    rdfs:range xsd:date .

pf:withdrawalAmount a owl:DatatypeProperty ;
    rdfs:label "提取金额" ;
    lg:owner pf:Withdrawal ;
    rdfs:range xsd:double .
pf:withdrawalDate a owl:DatatypeProperty ;
    rdfs:label "提取日期" ;
    lg:owner pf:Withdrawal ;
    rdfs:range xsd:date .
pf:withdrawalReason a owl:DatatypeProperty ;
    rdfs:label "提取原因" ;
    lg:owner pf:Withdrawal ;
    rdfs:range xsd:string .

pf:worksFor a owl:ObjectProperty ;
    rdfs:label "就职于" ;
    rdfs:comment "职工受雇于缴存单位" ;
    rdfs:domain pf:Contributor ;
    rdfs:range pf:Employer .
pf:contributesTo a owl:ObjectProperty ;
    rdfs:label "缴存于" ;
    rdfs:comment "缴存单位为职工账户缴存" ;
    rdfs:domain pf:Employer ;
    rdfs:range pf:FundAccount .
pf:appliesFor a owl:ObjectProperty ;
    rdfs:label "申请" ;
    rdfs:comment "职工申请公积金贷款" ;
    rdfs:domain pf:Contributor ;
    rdfs:range pf:Loan .
pf:filesWithdrawal a owl:ObjectProperty ;
    rdfs:label "办理" ;
    rdfs:comment "职工办理公积金提取" ;
    rdfs:domain pf:Contributor ;
    rdfs:range pf:Withdrawal .

pf:employmentStart a lg:RelationAttribute ;
    lg:owner pf:worksFor ;
    lg:attributeName "入职日期" ;
    lg:valueType "date" ;
    lg:description "职工入职缴存单位的日期" .
pf:contributionMonth a lg:RelationAttribute ;
    lg:owner pf:contributesTo ;
    lg:attributeName "缴存月份" ;
    lg:valueType "date" ;
    lg:description "住房公积金缴存所属月份" .
pf:loanApplicationDate a lg:RelationAttribute ;
    lg:owner pf:appliesFor ;
    lg:attributeName "申请日期" ;
    lg:valueType "date" ;
    lg:description "贷款申请日期" .
